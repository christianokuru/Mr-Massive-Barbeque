# Copy to .env.local for local dev. Set the same keys in Vercel → Settings → Environment Variables.
# Never commit real values.

# ── App URLs ── (production: both = https://massivebarbeque.com; local: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Database (Neon Postgres, pooled connection string) ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Images (Neon Object Storage, public_read bucket) ──
# Do NOT rename to AWS_* (Vercel reserves those names).
NEON_STORAGE_ENDPOINT=https://br-xxxx.storage.c-9.eu-central-1.aws.neon.tech
NEON_STORAGE_REGION=eu-central-1
NEON_STORAGE_BUCKET=media
# Neon credential token_id (nak_live_...) and s3_secret_access_key (nsk_live_...)
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
# Public base URL for objects: <endpoint>/<bucket>
NEXT_PUBLIC_MEDIA_URL=https://br-xxxx.storage.c-9.eu-central-1.aws.neon.tech/media

# ── Admin ── the single admin is the verified account with this email
ADMIN_EMAIL=

# ── Cron (Vercel Cron sends: Authorization: Bearer $CRON_SECRET) ──
# openssl rand -hex 24
CRON_SECRET=

# ── Payments (Paystack, NGN) ──
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── Email (Resend). Without a key, emails are logged to the server console. ──
RESEND_API_KEY=
EMAIL_FROM="Massive Barbeque <orders@mail.massivebarbeque.com>"

# ── Optional Google sign-in ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Web Push (admin new-order alerts). npx web-push generate-vapid-keys ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:you@example.com
VAPID_SUBJECT=

# ── Analytics (loaded only after cookie consent) ──
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
